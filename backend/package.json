{
  "name": "traycheck-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do TrayCheck (contrato docs/api/openapi.yaml)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "criar-admin": "tsx --env-file-if-exists=.env src/scripts/criar-admin.ts",
    "test": "tsx --env-file-if-exists=.env --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-openapi-validator": "^5.6.2",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
