# Copie este arquivo para .env e ajuste os valores do seu ambiente.
# O .env NÃO vai para o Git (está no backend/.gitignore).

# Servidor HTTP
PORT=3000
NODE_ENV=development
# Origem do frontend (Vite) liberada no CORS. Separe várias por vírgula.
CORS_ORIGIN=http://localhost:5173

# Banco MySQL 8 (migrações em ../db/migrations)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=traycheck
DB_POOL_LIMIT=10

# Caminho do contrato da API, relativo à pasta backend/
OPENAPI_PATH=../docs/api/openapi.yaml

# Sessão de login (RF02): expira após este número de horas sem atividade.
SESSAO_OCIOSA_HORAS=8

# Nome exibido no perfil do usuário (não há coluna no banco).
HOSPITAL_NOME=Hospital Central
