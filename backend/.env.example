# Copie este arquivo para .env e ajuste os valores do seu ambiente.
# O .env NÃO vai para o Git (está no backend/.gitignore).

# Servidor HTTP
PORT=3000
NODE_ENV=development
# Origem do frontend liberada no CORS (o Vite de src/ roda na porta 8443). Separe várias por vírgula.
CORS_ORIGIN=http://localhost:8443,http://127.0.0.1:8443

# Banco MySQL 8 (migrações em ../db/migrations)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=traycheck
DB_POOL_LIMIT=10

# Caminho do contrato da API, relativo à pasta backend/
OPENAPI_PATH=../docs/api/openapi.yaml

# Sessão de login (RF02): expira após este número de horas sem atividade.
SESSAO_OCIOSA_HORAS=8

# Nome exibido no perfil do usuário (não há coluna no banco).
HOSPITAL_NOME=Hospital Central

# ── Voz do assistente (ElevenLabs) ─────────────────────────────────────────────
# A chave fica SOMENTE aqui (backend/.env, que não vai para o Git). Nunca coloque em arquivos do frontend.
# Sem chave ou sem voz, a conferência funciona com a voz do navegador.
ELEVENLABS_API_KEY=
# ID de uma voz MASCULINA em português do Brasil, escolhida na Voice Library da ElevenLabs
# (filtre por idioma "Portuguese" e gênero "Male"; ouça antes de escolher).
ELEVENLABS_VOICE_ID=
# Multilingual v2: melhor qualidade em PT-BR e aceita ajuste de velocidade. Flash v2.5 é mais rápido, com menos naturalidade.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Ajustes de tom (0 a 1; velocidade 0.7 a 1.2). Estabilidade alta = voz mais serena e uniforme.
ELEVENLABS_STABILITY=0.65
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0
ELEVENLABS_SPEED=0.95
ELEVENLABS_TIMEOUT_MS=15000
# Cache de frases já sintetizadas (evita chamadas repetidas) e limite por usuário.
VOZ_CACHE_ITENS=200
VOZ_LIMITE_POR_MINUTO=60
