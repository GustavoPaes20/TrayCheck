    estoque_movimentacao [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1E3A8A" COLSPAN="3"><FONT COLOR="white"><B>estoque_movimentacao</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDE9FE">PK</TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDE9FE">FK</TD><TD ALIGN="LEFT" PORT="estoque_item_id">estoque_item_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDE9FE"></TD><TD ALIGN="LEFT" PORT="delta">delta</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDE9FE"></TD><TD ALIGN="LEFT" PORT="motivo">motivo</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280">varchar(200)?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDE9FE">FK</TD><TD ALIGN="LEFT" PORT="usuario_id">usuario_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDE9FE"></TD><TD ALIGN="LEFT" PORT="criado_em">criado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280">datetime</FONT></TD></TR></TABLE>>];
  }
  checklist_padrao:id -> checagem:checklist_padrao_id [style=solid, penwidth=1.4];
