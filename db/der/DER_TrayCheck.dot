digraph DER {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.5, ranksep=1.0, pad=0.4, label="TrayCheck — Modelo de Dados (MySQL 8) — gerado a partir de db/migrations\nLinhas pontilhadas cinza: autoria (usuário que criou/registrou o dado)", labelloc=t];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#475569", arrowhead=crow, arrowtail=tee, dir=both];
  subgraph cluster_0 { label="Autenticação e perfis (CI-05)"; style="rounded,dashed"; color="#94A3B8";
    perfil [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1E3A8A" COLSPAN="3"><FONT COLOR="white"><B>perfil</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DBEAFE">PK</TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DBEAFE">UQ</TD><TD ALIGN="LEFT" PORT="codigo">codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#DBEAFE"></TD><TD ALIGN="LEFT" PORT="nome">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280">varchar(60)</FONT></TD></TR></TABLE>>];
